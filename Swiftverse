
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SWIFTVERSE | Taylor Swift</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #090a17;
    color: #f4f1ff;
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
}

:root {
    --purple: #a98bff;
    --pink: #efb7e8;
    --dark: #090a17;
    --card: #14152a;
}

/* BACKGROUND */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    background:
        radial-gradient(circle at 15% 15%, #4c287b35, transparent 35%),
        radial-gradient(circle at 85% 60%, #b05aaf20, transparent 35%),
        #090a17;
}

.stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background-image:
        radial-gradient(1px 1px at 15% 25%, white 100%, transparent),
        radial-gradient(1px 1px at 70% 10%, white 100%, transparent),
        radial-gradient(2px 2px at 40% 70%, #bca9ff 100%, transparent),
        radial-gradient(1px 1px at 90% 90%, white 100%, transparent),
        radial-gradient(1px 1px at 30% 40%, white 100%, transparent);
    background-size: 250px 250px;
    opacity: .45;
    animation: starsMove 50s linear infinite;
}

@keyframes starsMove {
    from { transform: translateY(0); }
    to { transform: translateY(-250px); }
}

/* NAVIGATION */

nav {
    position: fixed;
    width: 100%;
    top: 0;
    left: 0;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #090a17d9;
    backdrop-filter: blur(15px);
    z-index: 1000;
    border-bottom: 1px solid #ffffff10;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    letter-spacing: 4px;
    color: #e5c6ff;
}

.logo span {
    color: white;
}

nav ul {
    display: flex;
    gap: 22px;
    list-style: none;
    flex-wrap: wrap;
}

nav a {
    color: #b8b5cc;
    text-decoration: none;
    font-size: 12px;
    transition: .3s;
}

nav a:hover {
    color: white;
}

/* HERO */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 130px 20px 80px;
    position: relative;
}

.hero-content {
    max-width: 900px;
    animation: appear 1.3s ease;
}

.tag {
    color: #c6a8ff;
    letter-spacing: 6px;
    font-size: 11px;
    text-transform: uppercase;
}

.hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(55px, 10vw, 115px);
    line-height: 1.1;
    margin: 25px 0;
    background: linear-gradient(120deg, white, #d5b7ff, #e8b5e5);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero p {
    color: #aaa8c1;
    font-size: 16px;
    line-height: 1.8;
    max-width: 600px;
    margin: auto;
}

.buttons {
    margin-top: 35px;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    padding: 14px 28px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 13px;
    transition: .3s;
    cursor: pointer;
    border: 1px solid #a98bff;
}

.primary {
    background: #a98bff;
    color: #0a0914;
}

.secondary {
    color: white;
    background: transparent;
}

.btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 25px #a98bff40;
}

/* GENERAL SECTIONS */

section {
    padding: 100px 8%;
}

.section-title {
    font-family: 'Playfair Display', serif;
    font-size: 45px;
    margin-bottom: 15px;
}

.section-sub {
    color: #9998b1;
    margin-bottom: 45px;
    line-height: 1.7;
}

.section-header {
    text-align: center;
}

/* ABOUT */

.intro {
    text-align: center;
    max-width: 850px;
    margin: auto;
}

.intro p {
    color: #b3b0c8;
    line-height: 2;
    font-size: 15px;
}

/* ALBUMS */

.album-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 25px;
}

.album {
    border-radius: 18px;
    padding: 22px;
    min-height: 265px;
    position: relative;
    overflow: hidden;
    transition: .4s;
    border: 1px solid #ffffff12;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.album:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 10px 40px #0005;
}

.album::before {
    content: "✦";
    font-size: 100px;
    position: absolute;
    right: -15px;
    top: 10px;
    opacity: .13;
    pointer-events: none;
}

.album small {
    letter-spacing: 3px;
    font-size: 10px;
    color: #ffffffa0;
}

.album h3 {
    font-family: 'Playfair Display', serif;
    font-size: 25px;
    position: relative;
}

.album p {
    font-size: 12px;
    opacity: .8;
    margin-top: 10px;
}

.album button {
    margin-top: 20px;
    width: fit-content;
    border: 1px solid #ffffff55;
    background: #ffffff10;
    color: white;
    padding: 10px 16px;
    border-radius: 30px;
    cursor: pointer;
    position: relative;
    transition: .3s;
}

.album button:hover {
    background: white;
    color: #111;
}

/* ALBUM COLORS */

.debut { background: linear-gradient(140deg,#456b52,#122a22); }
.fearless { background: linear-gradient(140deg,#b89042,#533817); }
.speak { background: linear-gradient(140deg,#8c5ba4,#30194e); }
.red { background: linear-gradient(140deg,#b34b54,#52151d); }
.nineteen { background: linear-gradient(140deg,#3b98b4,#133d57); }
.reputation { background: linear-gradient(140deg,#42424a,#121219); }
.lover { background: linear-gradient(140deg,#e4a5ce,#7d3f79); }
.folklore { background: linear-gradient(140deg,#777b7a,#292c2b); }
.evermore { background: linear-gradient(140deg,#7c5740,#35251c); }
.midnights { background: linear-gradient(140deg,#46538e,#171d46); }
.tortured { background: linear-gradient(140deg,#9c9993,#36332f); }
.showgirl { background: linear-gradient(140deg,#d78543,#70381b); }

/* MUSIC */

.music-box {
    background: linear-gradient(135deg, #17152a, #24203b);
    border: 1px solid #ffffff10;
    padding: 45px;
    border-radius: 25px;
    text-align: center;
}

.music-box h3 {
    font-family: 'Playfair Display', serif;
    font-size: 30px;
    margin-bottom: 15px;
}

.music-box p {
    color: #aaa8c1;
    line-height: 1.8;
}

.song-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-top: 35px;
}

.song {
    background: #ffffff08;
    border: 1px solid #ffffff12;
    border-radius: 12px;
    padding: 20px;
    text-align: left;
    transition: .3s;
}

.song:hover {
    background: #a98bff20;
    transform: translateY(-3px);
}

.song h4 {
    font-size: 16px;
    margin-bottom: 8px;
}

.song p {
    font-size: 12px;
    margin-top: 6px;
    margin-bottom: 12px;
}

.song a {
    color: #c5a5ff;
    text-decoration: none;
    font-size: 13px;
}

.song a:hover {
    text-decoration: underline;
}

/* BIRTHDAY COUNTDOWN */

.birthday-box {
    text-align: center;
    background: linear-gradient(145deg, #17132e, #30204a, #151529);
    border: 1px solid #b69aff35;
    border-radius: 28px;
    padding: 50px 20px;
    box-shadow: 0 0 60px #9b70ff12;
}

.birthday-box h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(38px, 7vw, 65px);
    margin: 20px 0 10px;
    color: #e5d5ff;
}

.birthday-date {
    color: #b6abc9;
    margin-bottom: 35px;
}

.countdown {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    margin: 30px 0;
}

.time-box {
    width: 105px;
    padding: 22px 10px;
    border-radius: 18px;
    background: #ffffff09;
    border: 1px solid #c4a7ff25;
}

.time-box span {
    display: block;
    font-size: 35px;
    font-weight: bold;
    color: #d8c2ff;
}

.time-box small {
    display: block;
    font-size: 10px;
    letter-spacing: 3px;
    margin-top: 10px;
    color: #a39ab9;
}

#birthday-message {
    color: #c5b5e5;
}

/* WISHES WALL */

.wish-container {
    max-width: 700px;
    margin: auto;
}

#wishForm {
    background: #151428;
    padding: 25px;
    border-radius: 20px;
    border: 1px solid #ffffff10;
}

#wishName,
#wishText {
    width: 100%;
    background: #0b0b19;
    border: 1px solid #ffffff18;
    color: white;
    padding: 15px;
    border-radius: 12px;
    margin-bottom: 15px;
    outline: none;
    font-family: inherit;
}

#wishName:focus,
#wishText:focus {
    border-color: #b69aff;
}

#wishText {
    resize: vertical;
    min-height: 130px;
}

.wish-button {
    width: 100%;
    padding: 15px;
    background: linear-gradient(90deg, #a98bff, #dfafea);
    color: #151020;
    border: none;
    border-radius: 30px;
    font-weight: bold;
    cursor: pointer;
    transition: .3s;
}

.wish-button:hover {
    opacity: .85;
    transform: translateY(-2px);
}

#wishStatus {
    color: #d0baff;
    text-align: center;
    margin: 20px 0;
}

.wish-card {
    background: #151428;
    border: 1px solid #ffffff10;
    border-radius: 15px;
    padding: 20px;
    margin-top: 15px;
    animation: appear .4s ease;
    overflow-wrap: anywhere;
}

.wish-card h4 {
    color: #d3b9ff;
    margin-bottom: 10px;
}

.wish-card p {
    color: #c2bfd2;
    line-height: 1.7;
}

.wish-card small {
    color: #79758e;
    display: block;
    margin-top: 12px;
}

/* TIMELINE */

.timeline {
    max-width: 700px;
    margin: auto;
    border-left: 1px solid #a98bff60;
    padding-left: 30px;
}

.timeline-item {
    margin-bottom: 35px;
    position: relative;
}

.timeline-item::before {
    content: "";
    width: 10px;
    height: 10px;
    background: #b69aff;
    border-radius: 50%;
    position: absolute;
    left: -36px;
    top: 6px;
    box-shadow: 0 0 15px #b69aff;
}

.timeline-item h3 {
    font-family: 'Playfair Display', serif;
    font-size: 23px;
    margin-bottom: 8px;
}

.timeline-item p {
    color: #a9a7bf;
    font-size: 14px;
    line-height: 1.8;
}

/* QUOTE */

.quote {
    text-align: center;
    max-width: 800px;
    margin: auto;
    padding: 80px 20px;
}

.quote h2 {
    font-family: 'Playfair Display', serif;
    font-size: 35px;
    line-height: 1.5;
    color: #d7c0ff;
}

/* FOOTER */

footer {
    border-top: 1px solid #ffffff12;
    text-align: center;
    padding: 35px 20px;
    color: #77758f;
    font-size: 12px;
    line-height: 2;
}

footer strong {
    color: #c4a5ff;
}

/* ANIMATION */

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(25px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.reveal {
    opacity: 0;
    transform: translateY(35px);
    transition: 1s;
}

.reveal.show {
    opacity: 1;
    transform: translateY(0);
}

/* MOBILE */

@media(max-width:700px) {

    nav {
        padding: 15px 4%;
        align-items: center;
    }

    .logo {
        font-size: 16px;
        letter-spacing: 2px;
    }

    nav ul {
        gap: 9px;
        justify-content: flex-end;
    }

    nav a {
        font-size: 10px;
    }

    .hero h1 {
        font-size: 65px;
    }

    .hero p {
        font-size: 14px;
    }

    section {
        padding: 75px 6%;
    }

    .section-title {
        font-size: 34px;
    }

    .album-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .album {
        min-height: 230px;
        padding: 17px;
    }

    .album h3 {
        font-size: 20px;
    }

    .album button {
        font-size: 11px;
        padding: 9px 12px;
    }

    .music-box {
        padding: 25px 15px;
    }

    .quote h2 {
        font-size: 27px;
    }
}

@media(max-width:380px) {

    nav ul {
        gap: 6px;
    }

    nav a {
        font-size: 9px;
    }

    .album-grid {
        grid-template-columns: 1fr;
    }

    .time-box {
        width: 67px;
    }
}
</style>
</head>

