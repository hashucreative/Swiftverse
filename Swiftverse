<!-- BIRTHDAY COUNTDOWN -->
<section id="birthday">

    <div class="birthday-box reveal">

        <div class="tag">A special day is coming</div>

        <h2>Taylor's Birthday</h2>

        <p class="birthday-date">
            December 13 · The day the world got a little more musical
        </p>

        <div class="countdown">

            <div class="time-box">
                <span id="days">00</span>
                <small>DAYS</small>
            </div>

            <div class="time-box">
                <span id="hours">00</span>
                <small>HOURS</small>
            </div>

            <div class="time-box">
                <span id="minutes">00</span>
     
